# ============================
# GENERAL
# ============================
NODE_ENV=development
ENVIRONMENT=development          # development | staging | production
COMPOSE_PROJECT_NAME=myapp

# ============================
# POSTGRESQL
# ============================
POSTGRES_USER=myapp_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=myapp_db
POSTGRES_HOST=db                 # service name in docker-compose
POSTGRES_PORT=5432

# Full async connection string for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://myapp_user:change_me_strong_password@db:5432/myapp_db

# ============================
# REDIS
# ============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# ============================
# JWT AUTH
# ============================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================
# FASTAPI (BACKEND)
# ============================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
API_V1_PREFIX=/api/v1
SECRET_KEY=replace_with_another_openssl_rand_hex_32   # general app secret, separate from JWT key

# ============================
# NEXT.JS (FRONTEND)
# ============================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32     # openssl rand -base64 32

# ============================
# EMAIL (optional, e.g. password reset)
# ============================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@example.com

# ============================
# DOCKER-SPECIFIC
# ============================
DOCKER_RESTART_POLICY=unless-stopped
