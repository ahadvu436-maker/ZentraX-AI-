# Copy to .env (and optionally .env.development / .env.staging / .env.production).
# Precedence: real environment > .env.<APP_ENV> > .env > built-in defaults.
# Lists accept comma separated values or a JSON array. Empty values count as unset.

# --- Application ------------------------------------------------------------
APP_ENV=development            # development | staging | production | testing
APP_NAME=ZentraX-AI
APP_VERSION=0.1.0
APP_DEBUG=false                # must be false in staging/production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=1
APP_DATA_DIR=data

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                # json | console
LOG_FILE_ENABLED=false
LOG_DIRECTORY=logs
LOG_REDACT_SENSITIVE=true

# --- Database ---------------------------------------------------------------
# Schemes: sqlite, postgresql[+psycopg|+psycopg2|+asyncpg], mysql[+pymysql|+aiomysql], mariadb
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/appdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_SSL_MODE=prefer       # disable | prefer | require | verify-ca | verify-full

# --- Model ------------------------------------------------------------------
MODEL_NAME=base-model
MODEL_VERSION=1.0.0
MODEL_DEVICE=auto              # auto | cpu | cuda | mps
MODEL_PRECISION=fp32           # fp32 | fp16 | bf16
MODEL_LEARNING_RATE=0.0003
MODEL_BATCH_SIZE=32
MODEL_MAX_SEQUENCE_LENGTH=2048
MODEL_MAX_NEW_TOKENS=512

# --- Security ---------------------------------------------------------------
# Required in staging/production (>= 32 chars, no placeholder words). Generate with:
#   python -c "from Configuration import generate_secret_key; print(generate_secret_key())"
SECURITY_SECRET_KEY=
# Required in production. Generate with:
#   python -c "from Configuration import generate_encryption_key; print(generate_encryption_key())"
SECURITY_ENCRYPTION_KEY=
SECURITY_ACCESS_TOKEN_TTL_MINUTES=15
SECURITY_REFRESH_TOKEN_TTL_DAYS=7
SECURITY_ALLOWED_HOSTS=localhost,127.0.0.1
SECURITY_CORS_ORIGINS=
