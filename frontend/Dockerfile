# frontend/Dockerfile
#
# Multi-stage, minimal-size production image for the ZentraX AI Next.js
# frontend.
#
# Requires next.config.js to include:
# module.exports = { output: "standalone", ... }
# This makes `next build` emit a self-contained server with only the
# runtime files it actually needs, so the final image doesn't have to
# carry the full node_modules tree or the Next.js build toolchain.
#
# Build:
# docker build -t zentrax-frontend ./frontend
# Run:
# docker run -p 3000:3000 --env-file .env zentrax-frontend

# --------------------------------------------------------------------------- #
# Stage 1: install production dependencies
# --------------------------------------------------------------------------- #
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts

# --------------------------------------------------------------------------- #
# Stage 2: build the app
# --------------------------------------------------------------------------- #
FROM node:20-alpine AS builder
WORKDIR /app

# The build itself needs devDependencies (TypeScript, Tailwind, etc.), so
# this stage installs the full dependency set rather than reusing `deps`.
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

COPY . .

# Public, build-time configuration only. Anything prefixed NEXT_PUBLIC_ is
# inlined into the client JS bundle and visible to anyone in the browser —
# never pass real secrets through a build ARG/ENV.
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# --------------------------------------------------------------------------- #
# Stage 3: minimal runtime image
# --------------------------------------------------------------------------- #
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
NEXT_TELEMETRY_DISABLED=1 \
PORT=3000 \
HOSTNAME=0.0.0.0

# Only the standalone server, static assets, and public files are copied —
# no source, no node_modules, no build cache. The official Node image
# already ships a low-privilege "node" user (uid/gid 1000); reuse it
# instead of creating a new one.
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
CMD node -e "require('http').get('http://127.0.0.1:3000/', (r) => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', ()=> process.exit(1))"
  
  # server.js is generated by the Next.js standalone build output.
  CMD ["node", "server.js"]